# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# A build cache moved aside when the disk filled rather than deleted outright.
/.next-corrupt-cache/

# production
/build

# misc
.DS_Store
*.pem

# scratch harnesses. Kept out of the tree because eslint reads everything it
# finds, and a throwaway script failing the repo's own lint is a false alarm
# nobody can act on.
/.abcheck/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
